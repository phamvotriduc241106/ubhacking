# Optional: enables Gemini image analysis on the backend.
# Never commit a real key.
GEMINI_API_KEY=
# Optional model choice for Gemini image and report calls
GEMINI_MODEL=gemini-2.5-flash
# Vision request budgets: defaults 40 seconds per attempt, 65 seconds total,
# up to 2 attempts. Ranges: 1-60 seconds, 1-90 seconds, and 1-3 attempts.
GEMINI_VISION_TIMEOUT_SECONDS=40
GEMINI_VISION_TOTAL_TIMEOUT_SECONDS=65
GEMINI_VISION_MAX_ATTEMPTS=2

# Optional METRO 328 USB serial port (115200 baud); leave empty for simulated data
FOLLAND_SERIAL_PORT=
# Optional: comma-separated trusted browser origins when frontend is hosted separately
FOLLAND_CORS_ORIGINS=
# Optional: serve a built frontend from the same FastAPI origin
FOLLAND_SERVE_FRONTEND=0
